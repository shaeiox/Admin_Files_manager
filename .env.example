# Dimension Files Manager - configuration template (copy to .env for local development).
# Secret-free and host-free by design. In production these values come from the
# systemd EnvironmentFile (see docs/DEPLOYMENT.md), never from a file in a release.
#
# Precedence: a variable already present in the process environment always wins;
# dotenv only fills variables that are unset. So a service-manager value is never
# overridden by a .env that happens to sit in the working directory.
# All values are read once at startup; changing one requires a restart.

# REQUIRED. Absolute path of the directory the file manager exposes. Must already
# exist and be a readable, traversable directory - the service never creates it.
STORAGE_ROOT=

# Optional. HTTP port. Default: 3000.
# PORT=3000

# Optional. Environment name. Default: development.
# `production` additionally REQUIRES AFM_DATA_DIR (no working-directory fallback).
# NODE_ENV=development

# Optional outside production; REQUIRED when NODE_ENV=production.
# Absolute directory holding the metadata and settings stores
# (metadata.json, settings.json). Default outside production: <cwd>/data.
# AFM_DATA_DIR=

# Optional. Maximum upload size in bytes: a positive integer. Default: 5368709120 (5 GiB).
# Keep the reverse proxy's body ceiling ABOVE this value (scripts/nginx/dimension.conf).
# UPLOAD_MAX_BYTES=5368709120

# ─── Security controls (optional; every default is the safe one) ───
# An unset file never widens access. See docs/DEPLOYMENT.md for the full table.

# Optional. Cross-origin access is SAME-ORIGIN by default: leave this unset and no
# CORS header is emitted at all, so the browser refuses every cross-origin call.
# The shipped SPA is same-origin and needs nothing here.
# AFM_CORS_ENABLED=false

# Optional. Comma-separated ABSOLUTE origins, e.g.
#   AFM_CORS_ALLOWED_ORIGINS=https://files.example.internal,https://admin.example.internal
# Each entry needs a scheme and host and must carry NO path, query or fragment.
# A malformed entry refuses startup.
# AFM_CORS_ALLOWED_ORIGINS=

# Optional. Allows a literal `*` entry. Refuses startup when NODE_ENV=production:
# a wildcard is incompatible with the authentication this service does not have.
# AFM_CORS_ALLOW_WILDCARD=false

# Optional. Free space required on the staging volume before an upload is accepted.
# Below it the upload is refused with 507 BEFORE any byte is written. 0 disables.
# AFM_UPLOAD_FREE_SPACE_BYTES=104857600

# Optional. Uploads accepted at once per process; the excess gets 429. 0 disables.
# AFM_UPLOAD_MAX_CONCURRENT=4

# Optional. Per-client allowances. Writes and reads use SEPARATE buckets, so a read
# burst never spends the mutation allowance. 0 disables either.
# AFM_RATE_LIMIT_WRITE_PER_MINUTE=60
# AFM_RATE_LIMIT_READ_PER_MINUTE=600
