{"nodes": [{"id": "docs_decisions_adr_001_architecture_baseline", "label": "ADR-001 - Architecture Baseline: Filesystem-as-Database with a Secured Path Boundary", "file_type": "document", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_filesystem_as_database", "label": "Node's filesystem is the database (rationale: zero infrastructure, backup = copy two directories; SQLite/Postgres rejected as drift-prone over-engineering)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_secured_path_boundary", "label": "A single, mandatory path boundary (rationale: the API accepts arbitrary client paths, so path containment is centralized to be auditable in one function)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_layered_backend", "label": "Layered backend with framework-free services (rationale: a monolithic route file would scatter path validation exactly where traversal bugs breed)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_no_build_frontend", "label": "No-build vanilla frontend (rationale: trades DX niceties for zero toolchain; internal admin UI needs no framework, SEO, or CDN pipeline)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_streaming_io", "label": "Streaming as the default for I/O-heavy endpoints (rationale: uploads/download/ZIP are piped, never buffered whole in memory)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_metadata_store_tradeoffs", "label": "JSON metadata store trade-offs (per-process singleton cache loses consistency under multiple instances; no trash/recycle; silent upload overwrite; npm test is a stub)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001_architecture_baseline_commonjs_express5", "label": "CommonJS Express 5 on Node LTS (pathless-middleware SPA fallback instead of wildcard route patterns)", "file_type": "rationale", "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_adr_001_architecture_baseline", "target": "docs_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_adr_001_architecture_baseline", "target": "agents_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/ADR-001-architecture-baseline.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_adr_001_architecture_baseline", "target": "src_services_pathservice_resolvesecurepath", "relation": "r