# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Environment variables (Security: Never commit secrets)
.env
.env.local
.env.*
!.env.example

# Operating System Files
.DS_Store
Thumbs.db

# Application Data (Do not track actual server data/metadata)
# Everything under data/ except the placeholder: store documents, their temp
# files, recovery copies (*.corrupt-backup) and a local storage root (data/storage/).
data/*
!data/.gitkeep

# Local environment variables (Security: Never commit secrets)
.env
!.env.example

# Storage / Downloads (If testing locally)
download/

# Scratch harnesses and probes (never committed, never discovered by npm test)
temp/

# Security-audit skill output (local findings, not a committed artifact)
docs/security-audit/

# Knowledge-graph output (generated, no LLM cost to rebuild)
!graphify-out/
portal.log
# Runtime SQLite database
portal-state.sqlite
portal-state.sqlite-shm
portal-state.sqlite-wal

# Local AI agent tooling (per-developer state, never shared)
# .claude/   - launch configs and local scratchpads
# .freebuff/ - local project identity
# .opencode/ - agent commands, skills, plugins and session logs
.claude/
.freebuff/
.opencode/
